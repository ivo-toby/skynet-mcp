# Environment variables for Skynet-MCP

# LLM API keys for integration
OPENAI_API_KEY="your-openai-api-key-here"
# ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# GOOGLE_API_KEY="your-google-api-key-here"

# LLM configuration
# Set to "true" to use mock LLM responses instead of real API calls
USE_MOCK_LLM="true"
# Default model to use (gpt-4, gpt-4o, claude-3-opus, claude-3-sonnet, gemini-pro)
DEFAULT_LLM_MODEL="gpt-4o"

# MCP Tool configuration
# Set to "true" to attempt to connect to real MCP servers (will fall back to mocks)
ENABLE_REAL_TOOLS="false"
# Set to "true" to use mock tool responses instead of real tool execution
USE_MOCK_TOOLS="true"
# Path to MCP clients configuration file
MCP_CLIENTS_CONFIG_PATH="./mcp-clients.json"
# MCP server health check interval in milliseconds (default: 60000 ms / 1 minute)
MCP_HEALTH_CHECK_INTERVAL_MS="60000"
# MCP server connection timeout in milliseconds (default: 5000 ms / 5 seconds)
MCP_CONNECTION_TIMEOUT_MS="5000"

# Server configuration
SERVER_PORT=3002
# SERVER_HOST=0.0.0.0

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
